# .gitignore
# Rust
/target/
**/*.rs.bk

# Cargo.lock is committed (workspace contains binaries).

# Node / Tauri
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
/docs
/generate-Repo-Tree.py
/*.ps1
/repo-tree.md
/repo-tree.txt

# Logs
*.log

# Local models / media (large binaries must not be committed)
/models/

# tests/audio: ignore everything, then explicitly re-include the tracked
# markers and the fixtures README. Any WAV you drop into tests/audio/fixtures/
# stays ignored, which is the point.
/tests/audio/*
!/tests/audio/.gitkeep
!/tests/audio/fixtures/
/tests/audio/fixtures/*
!/tests/audio/fixtures/README.md
/tests/*.srt
/tests/*.vtt
/tests/*.ass
/tests/*.edl
/tests/*.xml
/tests/report_*.json

# Tooling
/tools/.cache/
/tools/.venv
# scratch
/temp*.ps1
/repo-audit.txt
/repo-tree.md
